    "engine": "auto",
    "openai_whisper_model": "small",
    "whisper_cpp_binary": "whisper-cli",
    "whisper_cpp_model": null,
    "language": null
  },
  "captions": {
    "max_chars_per_line": 42,
    "max_seconds": 6,
    "pause_break_seconds": 0.6,
    "min_seconds": 0.8
  },
  "contact_sheet": {
    "scene_threshold": 0.3,
    "min_shot_seconds": 0.5,
    "frame_width": 480
  },
  "check_render": {
    "black_min_seconds": 0.5,
    "freeze_min_seconds": 2.0,
    "silence_min_seconds": 1.0,

{
  "format": {
    "aspect": "16:9",
    "fps": 60,
    "review_resolution": [1920, 1080],
    "master_resolution": [1920, 1080]
  },
  "loudness": {
    "integrated_lufs": -14,
    "true_peak_dbtp": -1,
    "tolerance_lu": 1
  },
  "segments": {
    "target_minutes": [2, 3],
    "segment_agents_at_once": 5
  },
